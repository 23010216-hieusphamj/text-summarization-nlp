digraph G {
  graph [
    rankdir=TB,
    bgcolor="white",
    pad="0.25",
    nodesep="0.38",
    ranksep="0.45",
    splines=ortho,
    fontname="Arial",
    fontsize=15,
    labelloc="t",
    label="Workflow xây dựng và đánh giá hệ thống tóm tắt văn bản tiếng Anh",
    dpi=180
  ];

  node [
    shape=box,
    style="rounded,filled",
    fontname="Arial",
    fontsize=10,
    color="#4a6fa5",
    fillcolor="#eaf1fb",
    margin="0.16,0.10"
  ];
  edge [color="#555555", penwidth=1.0, arrowsize=0.75];

  subgraph cluster_data {
    label="1. Dữ liệu";
    style="rounded,dashed";
    color="#999999";
    fontname="Arial";
    fontsize=13;

    cnn [label="CNN/DailyMail\n(Hugging Face)"];
    gov [label="GOV.UK\nTự thu thập (crawl, OGL v3.0)", fillcolor="#fff4d6", color="#c9a227"];
    clean [label="Làm sạch dữ liệu\nGOV.UK: HTML → văn bản\nLoại trùng, lọc độ dài"];
    jsonl [label="Dữ liệu sạch\nJSONL: article / highlights", fillcolor="#f4f7fb"];

    cnn -> clean;
    gov -> clean;
    clean -> jsonl;
  }

  subgraph cluster_prep {
    label="2. Tiền xử lý và chia tập";
    style="rounded,dashed";
    color="#999999";
    fontname="Arial";
    fontsize=13;

    normalize [label="Chuẩn hóa văn bản\nThống nhất định dạng đầu vào"];
    split [label="Chia train / validation / test\nCNN/DM: 19.895 / 1.000 / 1.000\nGOV.UK: 3.102 / 387 / 389"];
    hf_tok [label="Tokenizer BART / T5\nInput tối đa 512 token\nTarget: 128 (CNN/DM), 64 (GOV.UK)"];
    sp_tok [label="SentencePiece BPE 16k\nSeq2Seq (huấn luyện CNN/DM)\nInput tối đa 512; target 128 token"];

    jsonl -> normalize;
    normalize -> split;
    split -> hf_tok;
    split -> sp_tok;
  }

  subgraph cluster_model {
    label="3. Mô hình";
    style="rounded,dashed";
    color="#999999";
    fontname="Arial";
    fontsize=13;

    baseline [label="Baseline trích xuất\nLead-3 / Lead-1\nTextRank-3 / TextRank-1", fillcolor="#f0f0f0", color="#888888"];
    s2s [label="Seq2Seq BiGRU 2 tầng\nBahdanau Attention\nHuấn luyện từ đầu"];
    bart [label="BART-base fine-tune\nCNN/DM (A) và GOV.UK (D)\nMô hình chính", fillcolor="#dff3e3", color="#3c8d53"];
    t5 [label="T5-small fine-tune\nMô hình so sánh"];
    select [label="Chọn epoch / cấu hình\ntrên validation\nKhông tinh chỉnh trên test", fillcolor="#fff4d6", color="#c9a227"];
    ckpt [label="Checkpoint tốt nhất\nLưu ngoài GitHub\n(Google Drive)", fillcolor="#f4f7fb"];

    sp_tok -> s2s;
    hf_tok -> bart;
    hf_tok -> t5;
    s2s -> select;
    bart -> select;
    t5 -> select;
    select -> ckpt;
  }

  subgraph cluster_eval {
    label="4. Đánh giá tổng hợp và phân tích";
    style="rounded,dashed";
    color="#999999";
    fontname="Arial";
    fontsize=13;

    testset [label="Tập test\nChạy một lần cho mỗi\ncấu hình đã chốt"];
    predictions [label="Sinh bản tóm tắt\ntừ các mô hình đã chọn"];
    metrics [label="Độ đo tự động\nROUGE-1/2/L/Lsum\nBERTScore F1, thời gian suy luận"];
    stats [label="Phân tích định lượng\nBootstrap CI 95%, kiểm định ghép cặp\nTheo độ dài, chéo miền, ablation giải mã"];
    curves [label="Đường cong huấn luyện\nLoss / ROUGE theo epoch"];
    human [label="Đánh giá định tính và chấm tay\nPhân tích lỗi 16 mẫu\nChấm tay 40 mẫu; inter-rater 8 mẫu"];
    outputs [label="Kết quả GĐ7\nBảng so sánh, biểu đồ, phân tích lỗi\nresults/ và docs/", fillcolor="#dff3e3", color="#3c8d53"];

    testset -> predictions;
    predictions -> metrics;
    metrics -> stats;
    predictions -> human;
    stats -> outputs;
    curves -> outputs;
    human -> outputs;
  }

  split -> baseline;
  split -> testset;
  baseline -> predictions;
  ckpt -> predictions;
  s2s -> curves;
  bart -> curves;
  t5 -> curves;
}
